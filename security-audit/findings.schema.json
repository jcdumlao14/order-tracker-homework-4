{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order Tracker Security Audit Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "title",
    "severity",
    "category",
    "description",
    "evidence",
    "recommendation",
    "status"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "mitigated",
        "closed"
      ]
    }
  }
}